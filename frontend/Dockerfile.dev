# Frontend Dockerfile for Development
# Multi-platform support: linux/amd64, linux/arm64

FROM node:18-alpine

# Set working directory
WORKDIR /app

# Create a non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Install system dependencies
RUN apk add --no-cache \
    curl \
    git

# Copy package files first for better Docker layer caching
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy application code
COPY . .

# Copy and make executable the Docker entrypoint script
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Create next.js directories with proper ownership
RUN mkdir -p .next .next/cache && \
    chown -R nextjs:nodejs .next /app /usr/local/bin/docker-entrypoint.sh

# Expose port
EXPOSE 3000

# Switch to non-root user
USER nextjs

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000 || exit 1

# Use Docker-specific entrypoint for URL replacement
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]