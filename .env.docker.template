# Environment Template for Docker Deployment
# Copy this file to .env and fill in your actual values

# Azure Configuration - REQUIRED
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=your_region_here
AZURE_DOC_INTELLIGENCE_KEY=your_doc_intelligence_key_here
AZURE_DOC_INTELLIGENCE_ENDPOINT=your_endpoint_here

# JWT Secret Key - AUTOMATICALLY GENERATED
# Leave this blank - it will be auto-generated by the start script
JWT_SECRET_KEY=

# Database Configuration
DATABASE_URL=sqlite:///./pandiver.db

# Development Settings
LOG_LEVEL=INFO
DEBUG=false

# Docker-specific settings
NEXT_PUBLIC_API_URL=http://localhost:8000