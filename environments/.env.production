# Production Environment Configuration
# This file contains configuration for production environment

# Environment
ENVIRONMENT=production
NODE_ENV=production

# Application Settings
DEBUG=false
LOG_LEVEL=warn

# Security (Azure Key Vault Integration - No Hardcoded Secrets)
# All secrets are retrieved from Azure Key Vault using managed identity
SECRET_KEY=uI0Kotf3qIXBihs8PyGJKO3DT_0j3ES0PzIhgxAKDy54_RU7ezN8Z5BSCNTXFlyns5Alk3xXm7db8lxpL8WtCQ
# For Azure deployment, replace with Key Vault reference:
# SECRET_KEY=@Microsoft.KeyVault(SecretUri=https://kv-pandiver-shared.vault.azure.net/secrets/secret-key/)

# Database Configuration (Azure SQL Database with Connection Pooling)
DATABASE_URL=${DATABASE_URL}  # Retrieved from Azure Key Vault
# Actual implementation: @Microsoft.KeyVault(SecretUri=https://kv-pandiver-shared.vault.azure.net/secrets/production-database-url/)

# JWT Configuration (Production Security)
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
ALGORITHM=HS256

# Azure Services (Production Keys from Key Vault)
AZURE_TRANSLATOR_KEY=${AZURE_TRANSLATOR_KEY}
AZURE_TRANSLATOR_REGION=${AZURE_TRANSLATOR_REGION}
AZURE_DOC_INTELLIGENCE_KEY=${AZURE_DOC_INTELLIGENCE_KEY}
AZURE_DOC_INTELLIGENCE_ENDPOINT=${AZURE_DOC_INTELLIGENCE_ENDPOINT}

# Adobe PDF Services (Retrieved from Azure Key Vault)
ADOBE_PDF_SERVICES_CLIENT_ID=${ADOBE_PDF_SERVICES_CLIENT_ID}
ADOBE_PDF_SERVICES_CLIENT_SECRET=${ADOBE_PDF_SERVICES_CLIENT_SECRET}

# API Configuration (Production URLs)
BACKEND_URL=https://api.pandiver.com
FRONTEND_URL=https://pandiver.com

# Frontend (Next.js) Configuration
NEXT_PUBLIC_API_URL=https://api.pandiver.com
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_APP_NAME=Pandiver - Smart PDF Parser
NEXT_PUBLIC_ENVIRONMENT=production

# CORS Settings (Restrictive for Production)
ALLOWED_ORIGINS=["https://pandiver.com", "https://www.pandiver.com"]
ALLOWED_METHODS=["GET", "POST", "PUT", "DELETE"]
ALLOWED_HEADERS=["Content-Type", "Authorization"]

# File Upload Settings (Production Limits)
MAX_FILE_SIZE=52428800  # 50MB for production
UPLOAD_DIR=/app/uploads
TEMP_DIR=/app/temp

# Feature Flags (Production)
ENABLE_DOCS=false  # Disable docs in production
ENABLE_CORS=true
ENABLE_METRICS=true
ENABLE_RATE_LIMITING=true

# Production Performance Settings
WORKER_PROCESSES=4
WORKER_CONNECTIONS=2000
WORKER_CLASS=uvicorn.workers.UvicornWorker
KEEPALIVE=2
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100
PRELOAD_APP=true

# Logging (Production - Structured JSON)
LOG_FILE=/var/log/pandiver/production.log
LOG_FORMAT=json
LOG_ROTATION=true
LOG_RETENTION_DAYS=90

# Azure Production Integration
AZURE_SUBSCRIPTION_ID=${AZURE_SUBSCRIPTION_ID}
AZURE_RESOURCE_GROUP=rg-pandiver-production
AZURE_LOCATION=eastus

# Application Insights (Production Monitoring)
APPLICATIONINSIGHTS_CONNECTION_STRING=${APPLICATIONINSIGHTS_CONNECTION_STRING}
APPLICATIONINSIGHTS_SAMPLING_PERCENTAGE=5

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_RETRIES=3

# Rate Limiting (Production)
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# Cache Configuration
REDIS_URL=${REDIS_URL}  # For session storage and caching
CACHE_TTL=3600

# SSL/TLS Configuration
SSL_REDIRECT=true
SECURE_COOKIES=true
SECURE_HEADERS=true

# Database Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Production Security Headers
SECURITY_HEADERS=true
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Monitoring and Alerting
ENABLE_PROMETHEUS_METRICS=true
ALERT_EMAIL=${ALERT_EMAIL}
ALERT_SLACK_WEBHOOK=${ALERT_SLACK_WEBHOOK}

# Auto-scaling Configuration (AKS)
MIN_REPLICAS=2
MAX_REPLICAS=10
TARGET_CPU_UTILIZATION=70
TARGET_MEMORY_UTILIZATION=80

# Production Optimizations
STATIC_FILE_CACHING=true
GZIP_COMPRESSION=true
ENABLE_CDN=true
CDN_URL=${CDN_URL}