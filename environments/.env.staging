# Staging Environment Configuration
# This file contains configuration for staging/system test environment

# Environment
ENVIRONMENT=staging
NODE_ENV=production

# Application Settings
DEBUG=false
LOG_LEVEL=info

# Security (Use Azure Key Vault References)
SECRET_KEY=SzArfL7Ir525P-rDoxyvyzscO_GaiUhIAnXn98o8hUs0ryK2o-Iy3K1un30EwmCrd12DOXLFpZjA428XRwarhA
# For Azure deployment, replace with Key Vault reference:
# SECRET_KEY=@Microsoft.KeyVault(SecretUri=https://kv-pandiver-shared.vault.azure.net/secrets/secret-key/)

# Database Configuration (Azure SQL Database)
DATABASE_URL=${DATABASE_URL}  # Retrieved from Azure Key Vault
# DATABASE_URL=@Microsoft.KeyVault(SecretUri=https://kv-pandiver-shared.vault.azure.net/secrets/staging-database-url/)

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours for staging
ALGORITHM=HS256

# Azure Services (Staging Keys from Key Vault)
AZURE_TRANSLATOR_KEY=${AZURE_TRANSLATOR_KEY}
AZURE_TRANSLATOR_REGION=${AZURE_TRANSLATOR_REGION}
AZURE_DOC_INTELLIGENCE_KEY=${AZURE_DOC_INTELLIGENCE_KEY}
AZURE_DOC_INTELLIGENCE_ENDPOINT=${AZURE_DOC_INTELLIGENCE_ENDPOINT}

# API Configuration (Azure Container Instances)
BACKEND_URL=http://pandiver-backend-staging.eastus.azurecontainer.io:8000
FRONTEND_URL=http://pandiver-frontend-staging.eastus.azurecontainer.io

# Frontend (Next.js) Configuration
NEXT_PUBLIC_API_URL=http://pandiver-backend-staging.eastus.azurecontainer.io:8000
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_APP_NAME=Pandiver - Smart PDF Parser (Staging)
NEXT_PUBLIC_ENVIRONMENT=staging

# CORS Settings (Staging Specific)
ALLOWED_ORIGINS=["http://pandiver-frontend-staging.eastus.azurecontainer.io", "https://pandiver-staging.azurewebsites.net"]
ALLOWED_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
ALLOWED_HEADERS=["Content-Type", "Authorization"]

# File Upload Settings
MAX_FILE_SIZE=20971520  # 20MB
UPLOAD_DIR=/app/uploads
TEMP_DIR=/app/temp

# Feature Flags (Staging)
ENABLE_DOCS=true  # Keep docs enabled for testing
ENABLE_CORS=true
ENABLE_METRICS=true
ENABLE_RATE_LIMITING=true

# Container Settings
WORKER_PROCESSES=2
WORKER_CONNECTIONS=1000

# Logging (Structured for Azure Monitor)
LOG_FILE=/var/log/pandiver/staging.log
LOG_FORMAT=json
LOG_ROTATION=true

# Azure Integration
AZURE_SUBSCRIPTION_ID=${AZURE_SUBSCRIPTION_ID}
AZURE_RESOURCE_GROUP=rg-pandiver-staging
AZURE_LOCATION=eastus

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=${APPLICATIONINSIGHTS_CONNECTION_STRING}

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Staging Specific
RESET_DB_ON_DEPLOY=false
STAGING_DATA_REFRESH=weekly